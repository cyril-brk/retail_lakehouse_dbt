# =============================================================================
# Copy to .env and fill in.  Load with:  set -a && source .env && set +a
# NEVER commit the real .env (see .gitignore).
# =============================================================================

# ---- Workspace (all targets) ----------------------------------------------
# <<< PLACEHOLDER >>> Workspace host, no scheme, no trailing slash.
DATABRICKS_HOST=adb-0000000000000000.0.azuredatabricks.net

# ---- DEV target (PAT auth) ------------------------------------------------
# <<< PLACEHOLDER >>> SQL Warehouse HTTP path.
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
# <<< PLACEHOLDER >>> Personal access token (starts with dapi...).
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# <<< PLACEHOLDER >>> UC catalog + schema for your dev work.
DATABRICKS_CATALOG=retail_lakehouse_dbt
DATABRICKS_SCHEMA=dbt_yourname

# ---- PROD target (OAuth service-principal / M2M) --------------------------
# <<< PLACEHOLDER >>> Prod warehouse + SP OAuth credentials.
DATABRICKS_HTTP_PATH_PROD=/sql/1.0/warehouses/yyyyyyyyyyyyyyyy
DATABRICKS_CATALOG_PROD=retail_lakehouse_prod
DATABRICKS_SCHEMA_PROD=analytics
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_CLIENT_SECRET=doseXXXXXXXXXXXXXXXXXXXXXXXXXXXX
